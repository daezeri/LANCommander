@page "/Settings/Archives"
@using LANCommander.Server.Settings
@using LANCommander.Server.Settings.Enums
@using LANCommander.Server.Data.Enums
@using LANCommander.Server.Services.Chunks
@using LANCommander.Server.Jobs.Recurring
@using Hangfire
@using Microsoft.Extensions.Options
@inject StorageLocationService StorageLocationService
@inject ChunkManifestService ChunkManifestService
@inject ChunkStore ChunkStore
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Archives" />

<PageContent Loading="StorageLocations == null">
    @if (StorageLocations != null)
    {
        <Form Model="Settings.Value" OnSubmit="SaveAsync" Loading="_saving">
            <FormItem Label="Allow Insecure Downloads">
                <Switch @bind-Value="Settings.Value.Server.Archives.AllowInsecureDownloads" />
            </FormItem>

            <FormItem Label="Generate Chunk Manifests" Help="Lets archives be converted to chunks, the groundwork for LAN peer-to-peer downloads. Archives are kept and still downloaded as before. Chunks are stored in the Chunks folder of the data directory.">
                <Switch @bind-Value="Settings.Value.Server.Archives.GenerateChunkManifests" />
            </FormItem>

            <FormItem Label="Download Format" Help="Whether launchers may download converted archives as chunks. Zips are always still served, so older launchers and games that haven't been converted keep working.">
                <EnumSelect TEnum="ChunkDownloadFormat" @bind-Value="Settings.Value.Server.Archives.DownloadFormat" />
            </FormItem>

            @if (Settings.Value.Server.Archives.GenerateChunkManifests && _progress != null)
            {
                <FormItem Label="Chunk Conversion" Help="Archives waiting are converted a few at a time every 10 minutes, oldest first. Failed archives are left until rebuilt from their archive list.">
                    <Flex Vertical Gap="Gap.Small">
                        <Flex Gap="Gap.Small" Wrap>
                            <Tag Small Success>@_progress.Count(ChunkManifestStatus.Ready) ready</Tag>
                            <Tag Small>@_progress.Count(ChunkManifestStatus.None) not converted</Tag>
                            <Tag Small Warning>@_progress.Count(ChunkManifestStatus.Stale) out of date</Tag>
                            <Tag Small Info>@_progress.Count(ChunkManifestStatus.Pending) converting</Tag>
                            <Tag Small Danger>@_progress.Count(ChunkManifestStatus.Failed) failed</Tag>
                        </Flex>

                        <span>
                            The chunk store holds <ByteSize Value="_progress.StoredSize" />.
                            Converting what's left needs at most <ByteSize Value="_progress.RemainingUncompressedSize" />, usually much less
                            @if (_freeSpace.HasValue)
                            {
                                <text>; <ByteSize Value="_freeSpace.Value" /> is free on that drive.</text>
                            }
                            else
                            {
                                <text>.</text>
                            }
                        </span>

                        @if (_freeSpace.HasValue && _progress.RemainingUncompressedSize > _freeSpace.Value)
                        {
                            <Alert Warning>The drive may run out of space before every archive is converted. Conversions that can't be written are marked Failed; the zips are never touched.</Alert>
                        }

                        <Flex Gap="Gap.Small">
                            <Button Icon="IconType.SquaresFour" Disabled="_progress.Remaining == 0" OnClick="BuildAllNow">Build All Now</Button>
                            <Button Icon="IconType.Broom" OnClick="CleanUpNow">Clean Up Store</Button>
                            <Button Text Icon="IconType.ArrowsClockwise" OnClick="LoadProgressAsync">Refresh</Button>
                        </Flex>
                    </Flex>
                </FormItem>
            }

            <FormItem Label="Max Upload Chunk Size (MB)">
                <NumberInput @bind-Value="Settings.Value.Server.Archives.MaxChunkSize" Min="1" />
            </FormItem>

            <FormItem Label="Storage Paths">
                <Flex Vertical Gap="Gap.Medium">
                    <Table TItem="StorageLocation" Items="StorageLocations" Key="l => l" NoPaging SettingsKey="settings-archive-storage">
                        <Columns>
                            <TemplateColumn TItem="StorageLocation" Title="Path">
                                <FilePicker @bind-Value="context.Path" Title="Select Storage Location" Root="@RootPath" OnSelected="path => OnPathSelected(context, path)" />
                            </TemplateColumn>
                            <TemplateColumn TItem="StorageLocation" Title="Default" Width="100px">
                                <Checkbox @bind-Value="context.Default" />
                            </TemplateColumn>
                            <ActionsColumn TItem="StorageLocation">
                                <Popconfirm OnConfirm="() => RemoveStorageLocation(context)" Title="Are you sure you want to remove this storage location?" OkText="Remove" Danger>
                                    <Button Text Danger Icon="IconType.X" title="Remove" />
                                </Popconfirm>
                            </ActionsColumn>
                        </Columns>
                    </Table>

                    <Flex Justify="Justify.End">
                        <Button Primary OnClick="AddStorageLocation">Add Path</Button>
                    </Flex>
                </Flex>
            </FormItem>

            <FormItem>
                <Button Primary Submit>Save</Button>
            </FormItem>
        </Form>
    }
</PageContent>

@code {
    List<StorageLocation>? StorageLocations;
    bool _saving;

    string RootPath = Path.GetPathRoot(Directory.GetCurrentDirectory());

    ChunkConversionProgress? _progress;
    long? _freeSpace;

    protected override async Task OnInitializedAsync()
    {
        StorageLocations = (await StorageLocationService.GetAsync(l => l.Type == SDK.Enums.StorageLocationType.Archive)).ToList();

        await LoadProgressAsync();
    }

    async Task LoadProgressAsync()
    {
        try
        {
            _progress = await ChunkManifestService.GetProgressAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The chunk conversion progress could not be loaded");
        }

        try
        {
            var storageLocation = await ChunkStore.GetStorageLocationAsync();
            var root = Path.GetPathRoot(Path.GetFullPath(SDK.AppPaths.ResolveStorageLocationPath(storageLocation.Path)));

            _freeSpace = string.IsNullOrEmpty(root) ? null : new DriveInfo(root).AvailableFreeSpace;
        }
        catch (Exception)
        {
            // A network path or a drive that can't be asked: the estimate is shown without it
            _freeSpace = null;
        }
    }

    void BuildAllNow()
    {
        BackgroundJob.Enqueue<ChunkManifestSweep>(sweep => sweep.ConvertAsync(int.MaxValue));

        Notifications.Info("Converting every archive that's waiting, one at a time, in the background. Refresh to follow its progress.");
    }

    void CleanUpNow()
    {
        BackgroundJob.Enqueue<ChunkStoreCleanup>(cleanup => cleanup.CleanUpNowAsync());

        Notifications.Info("Removing chunks no archive uses any more, in the background. This also runs by itself every night.");
    }

    async Task SaveAsync()
    {
        _saving = true;

        try
        {
            SettingsProvider.Update(s =>
            {
                s.Server.Archives = Settings.Value.Server.Archives;
            });

            if (StorageLocations!.Count > 0 && !StorageLocations.Any(l => l.Default))
                StorageLocations[0].Default = true;

            foreach (var storageLocation in StorageLocations)
            {
                storageLocation.Type = SDK.Enums.StorageLocationType.Archive;

                if (storageLocation.Id != Guid.Empty)
                    await StorageLocationService.UpdateAsync(storageLocation);
                else
                    await StorageLocationService.AddAsync(storageLocation);
            }

            Notifications.Success("Settings saved!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The settings could not be saved");
        }
        finally
        {
            _saving = false;
        }
    }

    void OnPathSelected(StorageLocation storageLocation, string path)
    {
        var appPath = Directory.GetCurrentDirectory();

        if (path != null && path.StartsWith(appPath))
            path = path.Substring(appPath.Length).TrimStart(Path.DirectorySeparatorChar).TrimEnd(Path.DirectorySeparatorChar);

        storageLocation.Path = path;
    }

    // New lists so the table notices the change
    void AddStorageLocation() =>
        StorageLocations = [.. StorageLocations!, new StorageLocation { Type = SDK.Enums.StorageLocationType.Archive }];

    void RemoveStorageLocation(StorageLocation storageLocation) =>
        StorageLocations = StorageLocations!.Where(l => l != storageLocation).ToList();
}
